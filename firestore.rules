rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only YOUR account can read or write YOUR data. Replace the placeholder below with your
    // user ID (Firebase console > Authentication > Users > "User UID"). With this in place,
    // even if someone created an account on your project they could not see or change anything.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.uid == 'PASTE_YOUR_USER_UID_HERE';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
